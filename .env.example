NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Активный провайдер генерации: openai (по умолчанию) или anthropic
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
ANTHROPIC_API_KEY=

# Postgres (персистентность паков/истории/избранного).
# Пустой DATABASE_URL => in-memory хранилище (без персистентности).
# docker-compose задаёт DATABASE_URL сам (через POSTGRES_* ниже).
DATABASE_URL=
POSTGRES_USER=chastushki
POSTGRES_PASSWORD=chastushki
POSTGRES_DB=chastushki
DB_PORT=5432
